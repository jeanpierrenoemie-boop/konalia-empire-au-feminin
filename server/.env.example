PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret-before-production
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite (default)
DB_DRIVER=sqlite
DB_PATH=./data/rc.db

# PostgreSQL (set DB_DRIVER=postgres and provide DATABASE_URL)
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/rc_db

# --- AI (optional) ---
# ANTHROPIC_API_KEY=sk-ant-...
