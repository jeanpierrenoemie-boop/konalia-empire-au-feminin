# ============================================================
#  NAIOM — Plateforme d'employés IA · Configuration
# ------------------------------------------------------------
#  Tu n'as PAS besoin de remplir ça à la main : ouvre le projet
#  avec Claude Code, il te posera les questions et remplira
#  ".env.local" pour toi (voir CLAUDE.md → Assistant d'installation).
#
#  Sinon : copie ce fichier en ".env.local" et mets tes valeurs.
#  Tout est OPTIONNEL sauf ANTHROPIC_API_KEY. La plateforme tourne
#  en mode démo tant qu'un outil n'est pas connecté.
# ============================================================

# ---------- OBLIGATOIRE ----------
# Ta clé API Claude — https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=

# ---------- MODE DÉMO ----------
# 1 = la plateforme tourne avec des données fictives (rien à connecter).
# Passe à 0 quand tu as branché tes vrais outils.
DEMO_MOCK=1

# ---------- PROSPECTION (Sacha) & VEILLE (Nina) ----------
# Scraping Google Maps / réseaux — https://console.apify.com → Settings → API & Integrations
APIFY_TOKEN=

# ---------- GMAIL / GOOGLE (Inès · Chloé · envoi Victor) ----------
# Identifiants OAuth Web — https://console.cloud.google.com (APIs & Services → Identifiants)
# (ou connecte-toi en 1 clic dans l'app : Réglages → Connexions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ---------- E-COMMERCE / VIDÉOS PRODUIT (Emma) ----------
# https://arcads.ai  → paramètres API
ARCADS_CLIENT_ID=
ARCADS_CLIENT_SECRET=

# ---------- COMPTABILITÉ (Chloé) ----------
# Jeton + IDs de bases Airtable — https://airtable.com/create/tokens
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_CLIENTS_BASE_ID=

# ---------- ANALYSE DE CALLS (Jules) ----------
# https://app.fireflies.ai → Settings → Developer
FIREFLIES_API_KEY=
# 1 = démo sans vrai compte Fireflies
FIREFLIES_MOCK=1

# ---------- DESIGNER / MINIATURES (Mia) ----------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ============================================================
#  NE PAS TOUCHER (mode template mono-agent — laissé vide ici
#  pour avoir TOUTE l'équipe visible) :
#  OWNED_AGENT=
#  NEXT_PUBLIC_OWNED_AGENT=
# ============================================================
